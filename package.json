{
  "name": "playlist-cover-generator",
  "version": "0.1.0",
  "type": "module",
  "description": "Embeddable React component for generating square playlist cover art with a clean, exportable SVG canvas.",
  "license": "MIT",
  "keywords": [
    "react",
    "svg",
    "playlist",
    "cover",
    "album-art",
    "editor",
    "image-editor"
  ],
  "main": "./dist/playlist-cover-generator.cjs",
  "module": "./dist/playlist-cover-generator.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/playlist-cover-generator.js",
      "require": "./dist/playlist-cover-generator.cjs"
    }
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.config.lib.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@headlessui/react": "2.2.10",
    "lucide-react": "1.17.0"
  },
  "devDependencies": {
    "@dnbhq/markdownlint-config": "0.2.7",
    "@eslint/js": "9.39.4",
    "@tailwindcss/vite": "^4.1.8",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "15.15.0",
    "jsdom": "29.1.1",
    "prettier": "3.8.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.8",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
