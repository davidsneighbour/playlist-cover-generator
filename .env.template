# Copy this file to .env.local and fill in the value. .env.local is gitignored.

# Google Fonts Developer API key — enables the font-search typeahead in the
# Fonts panel. Optional: without it you can still add fonts by typing an exact
# family name; with it you get live search suggestions.
#
# Get a key (free, no billing):
#   https://console.cloud.google.com/apis/library/webfonts.googleapis.com
#   APIs & Services -> Credentials -> Create credentials -> API key
#
# This is a client-side app, so the key ships in the built JS. Restrict it in
# the Cloud Console to the "Web Fonts Developer API" and to your HTTP referrers
# (include http://localhost:5173/* for local dev).
VITE_GOOGLE_FONTS_API_KEY=
